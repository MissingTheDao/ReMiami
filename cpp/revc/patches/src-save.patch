+// The chunk goes into work_buff first, as the original read it: some Load functions leave
+// pointers into their buffer, which later chunks overwrite (behaviour kept as it was).
+void
+revc_load_block(int index, const uint8 *chunk, size_t chunkLen, size_t offset, uint32 size)
+{
+	memcpy(work_buff, chunk, chunkLen < sizeof(work_buff) ? chunkLen : sizeof(work_buff));
+	uint8 *buf = work_buff + offset;
+	switch (index) {
+	case -1: CTheScripts::LoadAllScripts(buf, size); break;
+	case 0: CPools::LoadPedPool(buf, size); break;
+	case 1: CGarages::Load(buf, size); break;
+	case 2: CGameLogic::Load(buf, size); break;
+	case 3: CPools::LoadVehiclePool(buf, size); break;
+	case 4:
+		CProjectileInfo::RemoveAllProjectiles();
+		CObject::DeleteAllTempObjects();
+		CPools::LoadObjectPool(buf, size);
+		break;
+	case 5: ThePaths.Load(buf, size); break;
+	case 6: CCranes::Load(buf, size); break;
+	case 7: CPickups::Load(buf, size); break;
+	case 8: gPhoneInfo.Load(buf, size); break;
+	case 9: CRestart::LoadAllRestartPoints(buf, size); break;
+	case 10: CRadar::LoadAllRadarBlips(buf, size); break;
+	case 11: CTheZones::LoadAllZones(buf, size); break;
+	case 12: CGangs::LoadAllGangData(buf, size); break;
+	case 13:
+		CTheCarGenerators::LoadAllCarGenerators(buf, size);
+		CParticle::ReloadConfig();
+		break;
+	case 14: CParticleObject::LoadParticle(buf, size); break;
+	case 15: cAudioScriptObject::LoadAllAudioScriptObjects(buf, size); break;
+	case 16: CScriptPaths::Load(buf, size); break;
+	case 17: CWorld::Players[CWorld::PlayerInFocus].LoadPlayerInfo(buf, size); break;
+	case 18: CStats::LoadStats(buf, size); break;
+	case 19: CSetPieces::Load(buf, size); break;
+	case 20: CStreaming::MemoryCardLoad(buf, size); break;
+	case 21: CPedType::Load(buf, size); break;
+	}
