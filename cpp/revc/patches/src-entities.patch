+// Per-entity sway phase from where it stands (see ModifyMatrixForTreeInWind).
+uint16
+CEntity::PositionPhase(void)
+{
+	const CVector &pos = GetPosition();
+	return (uint16)((int32)(pos.x * 16.0f) * 31 + (int32)(pos.y * 16.0f) * 17 + (int32)(pos.z * 16.0f));
+}
