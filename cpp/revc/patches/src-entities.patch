+// revc test hook: REVC_TEST_HIDE_MODELS=name,name,... leaves those models undrawn (finding which
+// object draws what in a capture).
+static bool
+TestHiddenModel(int modelIndex)
+{
+	static const char *hide = getenv("REVC_TEST_HIDE_MODELS");
+	if(hide == nil || hide[0] == '\0')
+		return false;
+	const char *name = CModelInfo::GetModelInfo(modelIndex)->GetModelName();
+	size_t n = strlen(name);
+	for(const char *p = hide; *p; ){
+		const char *e = strchr(p, ',');
+		size_t len = e ? (size_t)(e - p) : strlen(p);
+		if(len == n && strncasecmp(p, name, n) == 0)
+			return true;
+		if(!e)
+			break;
+		p = e + 1;
+	}
+	return false;
+}
