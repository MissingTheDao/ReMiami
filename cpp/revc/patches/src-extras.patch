+// revc: the Xbox disc's own mask (neo/dropmask.dds, imported) when there is one
+extern "C" int revc_import_image(const char *rel, int *w, int *h, unsigned char **rgba);
+extern "C" void revc_texmod_free(unsigned char *rgba, int width, int height);
+static RwTexture*
+LoadDiscDropMask(void)
+{
+	int w, h;
+	unsigned char *px;
+	if(!revc_import_image("xbox/neo/dropmask.dds", &w, &h, &px))
+		return nil;
+	rw::Image *img = rw::Image::create(w, h, 32);
+	img->pixels = px;
+	img->stride = w * 4;
+	rw::Raster *ras = rw::Raster::create(w, h, 32, rw::Raster::C8888 | rw::Raster::TEXTURE);
+	rw::Texture *tex = nil;
+	if(ras && ras->setFromImage(img))
+		tex = rw::Texture::create(ras);
+	else if(ras)
+		ras->destroy();
+	img->pixels = nil;
+	img->destroy();
+	revc_texmod_free(px, w, h);
+	return tex;
+}
