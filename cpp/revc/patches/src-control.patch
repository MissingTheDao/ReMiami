+// revc: the Xbox's per-script buttons (its ScriptControls.txt; research on the Xbox build) where
+// they differ from what the PS2-style state gives under its layouts: -1 if not one of them.
+static int16
+XboxScriptButton(const char *script, uint16 button)
+{
+	auto is = [&](const char *name) {
+		for (int i = 0; i < 8; i++) {
+			char a = script[i] >= 'A' && script[i] <= 'Z' ? script[i] - 'A' + 'a' : script[i];
+			if (a != name[i])
+				return false;
+			if (a == '\0')
+				return true;
+		}
+		return true;
+	};
+	const int layout = XboxFlyLayout();
+	if (layout < 0)
+		return -1;
+	auto raw = [](int joy) -> int16 { return XboxRawDown(joy) ? 255 : 0; };
+	if (is("cell") && button == 4)	// answer the phone: LT
+		return raw(5);
+	if ((is("bankjo4") || is("shit")) && button == 16)	// back out: B
+		return raw(1);
+	if (is("pizza") && (button == 5 || button == 7)) {	// throw left / right: the right stick (Standard), the D-pad (Classic)
+		int16 x = layout == 1 ? (XboxRawDown(14) ? 1 : XboxRawDown(16) ? -1 : 0) : XboxStick(2);
+		return (button == 7 ? x > 0 : x < 0) ? 255 : 0;
+	}
+	if (is("race") && button == 15)	// cancel: B
+		return raw(1);
+	if (is("race") && button == 16)	// OK: A
+		return raw(2);
+	if ((is("ammu1") || is("ammu2") || is("ammu3") || is("hard1") || is("hard2") || is("hard3") || is("race")) &&
+	    (button == 10 || button == 11))	// browse: the D-pad itself (not bound to a PS2 D-pad press in the Xbox layouts)
+		return raw(button == 10 ? 16 : 14);
+	return -1;
+}
