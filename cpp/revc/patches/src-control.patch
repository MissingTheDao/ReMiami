+	const char *n = CModelInfo::GetModelInfo(mi)->GetModelName();
+	if (strlen(n) < 4)
+		return -1;
+	char lod[MAX_MODEL_NAME + 4];
+	snprintf(lod, sizeof(lod), "LOD%s", n + 3);
+	int32 id;
+	return CModelInfo::GetModelInfo(lod, &id) ? id : -1;
+}
+
+static int16
+FindLods(int32 lodModel, const CVector &pos, CEntity **found)
+{
+	int16 total = 0;
+	CWorld::FindObjectsOfTypeInRange(lodModel, pos, 10.0f, true, &total, 4, found, true, false, false, false, false);
+	if (total == 0)
+		CWorld::FindObjectsOfTypeInRangeSectorList(lodModel, CWorld::GetBigBuildingList(LEVEL_GENERIC), pos, 10.0f, true, &total, 4, found);
+	if (total == 0)
+		CWorld::FindObjectsOfTypeInRangeSectorList(lodModel, CWorld::GetBigBuildingList(CTheZones::GetLevelFromPosition(&pos)), pos, 10.0f, true, &total, 4, found);
+	return total;
+}
+
+void
+SwapBuildingLod(CBuilding *building, int32 from, int32 to)
+{
+	if (building == nil)
+		return;
+	int32 lodFrom = LodModelOf(from), lodTo = LodModelOf(to);
+	if (lodFrom == lodTo)
+		return;
+	CEntity *found[4];
+	if (lodFrom >= 0) {
+		int16 n = FindLods(lodFrom, building->GetPosition(), found);
+		for (int16 i = 0; i < n; i++) {
+			if (lodTo >= 0)
+				((CBuilding*)found[i])->ReplaceWithNewModel(lodTo);
+			else
+				found[i]->bIsVisible = false;
+		}
+	} else if (lodTo >= 0) {
+		// back to a model with a LOD: the hidden one shows again
+		int16 n = FindLods(lodTo, building->GetPosition(), found);
+		for (int16 i = 0; i < n; i++)
+			found[i]->bIsVisible = true;
+	}
+}
