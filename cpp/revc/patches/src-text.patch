+wchar*
+CText::GetRevcText(const char *key)
+{
+	// each text converted once into a buffer of its own length (a fixed 32-character slot let
+	// long texts run into the next ones)
+	static wchar *texts[ARRAY_SIZE(RevcTexts)];
+	for (int i = 0; i < (int)ARRAY_SIZE(RevcTexts); i++)
+		if (strncmp(key, RevcTexts[i].key, 8) == 0) {
+			if (texts[i] == nil) {
+				texts[i] = new wchar[strlen(RevcTexts[i].text) + 1];
+				AsciiToUnicode(RevcTexts[i].text, texts[i]);
+			}
+			return texts[i];
+		}
+	return nil;
+}
