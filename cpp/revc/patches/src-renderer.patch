+// revc (plan task 13): loads hud.txd again without touching the HUD's state, so texture packs
+// for another UI style (mods/packs/pc-*, ps2-*, xbox-*) take effect; the radar's sprites too.
+void CHud::ReloadTextures()
+{
+	for (int i = 0; i < NUM_HUD_SPRITES; ++i)
+		Sprites[i].Delete();
+	RwTexture **sights[] = { &gpSniperSightTex, &gpRocketSightTex, &gpLaserSightTex, &gpLaserDotTex, &gpViewFinderTex };
+	for (RwTexture **t : sights)
+		if (*t) {
+			RwTextureDestroy(*t);
+			*t = nil;
+		}
+	int slot = CTxdStore::FindTxdSlot("hud");
+	if (slot != -1)
+		CTxdStore::RemoveTxdSlot(slot);
+	slot = CTxdStore::AddTxdSlot("hud");
+	CTxdStore::LoadTxd(slot, "MODELS/HUD.TXD");
+	CTxdStore::AddRef(slot);
+	CTxdStore::PushCurrentTxd();
+	CTxdStore::SetCurrentTxd(slot);
+	for (int i = 0; i < NUM_HUD_SPRITES; i++)
+		Sprites[i].SetTexture(WeaponFilenames[i].name, WeaponFilenames[i].mask);
+	gpSniperSightTex = RwTextureRead("sitesniper", nil);
+	gpRocketSightTex = RwTextureRead("siterocket", nil);
+	gpLaserSightTex = RwTextureRead("sitelaser", nil);
+	gpLaserDotTex = RwTextureRead("laserdot", "laserdotm");
+	gpViewFinderTex = RwTextureRead("viewfinder_128", "viewfinder_128m");
+	CTxdStore::PopCurrentTxd();
+	CRadar::LoadTextures();
+}
