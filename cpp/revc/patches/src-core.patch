+
+// 0 Xbox Standard, 1 Xbox Classic, 2 original PC, -1 none of them (the player's own bindings).
+extern "C" int
+PadLayoutCurrent(void)
+{
+	bool match[3] = { true, true, true };
+	for (int i = 0; i < ARRAY_SIZE(padLayouts); i++) {
+		int32 key = ControlsManager.m_aSettings[padLayouts[i].action][JOYSTICK].m_Key;
+		match[0] &= key == padLayouts[i].standard;
+		match[1] &= key == padLayouts[i].classic;
+		match[2] &= key == padLayouts[i].pc;
+	}
+	return match[0] ? 0 : match[1] ? 1 : match[2] ? 2 : -1;
+}
+
+extern "C" void
+PadLayoutApply(int layout)
+{
+	for (int i = 0; i < ARRAY_SIZE(padLayouts); i++) {
+		e_ControllerAction action = padLayouts[i].action;
+		int32 key = layout == 0 ? padLayouts[i].standard : layout == 1 ? padLayouts[i].classic : padLayouts[i].pc;
+		ControlsManager.ClearSettingsAssociatedWithAction(action, JOYSTICK);
+		if (key != 0)
+			ControlsManager.SetControllerKeyAssociatedWithAction(action, key, JOYSTICK);
+	}
+}
