+DropAudio(int a, int style)
+{
+	return style != 0 && (a == MENUACTION_MP3VOLUMEBOOST || a == MENUACTION_DYNAMICACOUSTIC || a == MENUACTION_RESTOREDEF || a == MENUACTION_GOBACK);
+}
