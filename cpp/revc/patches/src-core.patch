+NeoAvailable(void)
+{
+#ifdef EXTENDED_PIPELINES
+	return CustomPipes::neoTxd != nil;
+#else
+	return false;
+#endif
+}
+
+// Index into visualStyles, or -1 for a mix of settings no preset has.
+static int
+CurrentVisualStyle(void)
+{
+	for (int i = 0; i < (int)ARRAY_SIZE(visualStyles); i++) {
+		const VisualStyle &s = visualStyles[i];
+		if (CPostFX::EffectSwitch != s.filter)
+			continue;
+		if (s.lod > 0.0f && Abs(FrontEndMenuManager.m_PrefsLOD - s.lod) > 0.01f)
+			continue;
+		if (s.ui >= 0 && gUiStyle != s.ui)
+			continue;
+		if (CPostFX::MotionBlurOn != s.trails)
+			continue;
+		if (s.control >= 0 && FrontEndMenuManager.m_ControlMethod != s.control)
+			continue;
+#ifdef PS2_ALPHA_TEST
+		if (!!gPS2alphaTest != s.alphaTest)
+			continue;
+#endif
+#ifdef EXTENDED_PIPELINES
+		if (NeoAvailable() &&
+		    ((CustomPipes::VehiclePipeSwitch == CustomPipes::VEHICLEPIPE_NEO) != s.neo || CustomPipes::RimlightEnable != s.neo ||
+		     CustomPipes::LightmapEnable != s.neo || CustomPipes::GlossEnable != s.neo))
+			continue;
+#endif
+		return i;
+	}
+	return -1;
+}
+
+// Index into visualStyles of the current settings (-1 Custom), for the rest of the game.
+int
+VisualStyleIndex(void)
+{
+	return CurrentVisualStyle();
+}
+
+static void
+ApplyVisualStyle(int i)
+{
+	const VisualStyle &s = visualStyles[i];
+	CPostFX::EffectSwitch = s.filter;
+	if (s.lod > 0.0f)
+		FrontEndMenuManager.m_PrefsLOD = CRenderer::ms_lodDistScale = s.lod;
+	if (s.ui >= 0)
+		gUiStyle = s.ui;
+	CPostFX::MotionBlurOn = s.trails;
+	if (s.control >= 0) {
+		FrontEndMenuManager.m_ControlMethod = s.control;
+		CCamera::m_bUseMouse3rdPerson = s.control == CONTROL_STANDARD;
+	}
+#ifdef PS2_ALPHA_TEST
+	gPS2alphaTest = s.alphaTest;
+#endif
+#ifdef EXTENDED_PIPELINES
+	if (NeoAvailable()) {
+		CustomPipes::VehiclePipeSwitch = s.neo ? CustomPipes::VEHICLEPIPE_NEO : CustomPipes::VEHICLEPIPE_MATFX;
+		CustomPipes::RimlightEnable = s.neo;
+		CustomPipes::LightmapEnable = s.neo;
+		CustomPipes::GlossEnable = s.neo;
+	}
+#endif
+}
+
+void
+VisualStyleButtonPress(int8 action)
+{
+	if (action != FEOPTION_ACTION_LEFT && action != FEOPTION_ACTION_RIGHT && action != FEOPTION_ACTION_SELECT)
+		return;
+	const int n = ARRAY_SIZE(visualStyles);
+	int cur = CurrentVisualStyle();
+	int next;
+	if (action == FEOPTION_ACTION_LEFT)
+		next = cur < 0 ? n - 1 : (cur + n - 1) % n;
+	else
+		next = cur < 0 ? 0 : (cur + 1) % n;
+	ApplyVisualStyle(next);
+	FrontEndMenuManager.SaveSettings();
+}
+
+wchar*
+VisualStyleDraw(bool *disabled, bool userHovering)
+{
+	int cur = CurrentVisualStyle();
+	return TheText.Get(cur < 0 ? "RVC_VSC" : visualStyles[cur].name);
+}
+#else
+int VisualStyleIndex(void) { return -1; }
+#endif
