+// revc (docs/RENDERER_PORT.md, stage 2 step 1): texture natives (PC D3D8, Xbox) are read in Rust
+// (rust/revc/src/txdload.rs); librw's platform readers are gone. The WGPU raster is built here
+// the way librw's D3D8 reader + Raster::convertTexToCurrentPlatform built it; checked against
+// their recorded result by the formats test (tests/golden/textures.txt, TxdHash below).
+extern "C" {
+struct RevcNativeTex {
+	char name[32], mask[32];
+	uint32 filterAddressing;
+	int32 format, type, width, height, depth, numLevels, dxt, hasAlpha;
+	uint8 *data;
+	size_t size;
+};
+int revc_txd_read_native(const uint8 *body, size_t len, RevcNativeTex *out);
+void revc_txd_free(RevcNativeTex *tex);
+}
+
+static rw::Texture*
+TextureFromNative(const RevcNativeTex &t)
+{
+	using namespace rw;
+	Raster *ras;
+	size_t off = 0;
+	if(t.dxt){
+		// as dxt_to_wgpu (vendor/librw/src/raster.cpp)
+		ras = Raster::create(t.width, t.height, t.depth, t.format | t.type | Raster::DONTALLOCATE);
+		if(ras == nil)
+			return nil;
+		ras->format = t.format;
+		wgpu::allocateDXT(ras, t.dxt, t.numLevels, t.hasAlpha);
+		for(int32 i = 0; i < ras->getNumLevels(); i++){
+			int32 lw = t.width >> i, lh = t.height >> i;
+			size_t n = wgpu::dxtLevelSize(t.dxt, lw < 1 ? 1 : lw, lh < 1 ? 1 : lh);
+			uint8 *dst = ras->lock(i, Raster::LOCKWRITE | Raster::LOCKNOFETCH);
+			if(dst && off + n <= t.size)
+				memcpy(dst, t.data + off, n);
+			off += n;
+			ras->unlock(i);
+		}
+	}else{
+		// as convertTexToCurrentPlatform's fallback: RGBA8 raster, levels from images
+		int32 format = Raster::C8888 | Raster::TEXTURE | (t.format & (Raster::MIPMAP | Raster::AUTOMIPMAP));
+		ras = Raster::create(t.width, t.height, 32, format);
+		if(ras == nil)
+			return nil;
+		for(int32 i = 0; i < t.numLevels; i++){
+			int32 lw = t.width >> i, lh = t.height >> i;
+			if(lw < 1) lw = 1;
+			if(lh < 1) lh = 1;
+			size_t n = (size_t)lw * lh * 4;
+			if(off + n > t.size)
+				break;
+			Image *img = Image::create(lw, lh, 32);
+			img->pixels = t.data + off;	// not owned (flags stay 0)
+			img->stride = lw * 4;
+			if(i == 0)
+				ras->setFromImage(img);
+			else{
+				ras->lock(i, Raster::LOCKWRITE | Raster::LOCKNOFETCH);
+				ras->setFromImage(img);
+				ras->unlock(i);
+			}
+			img->pixels = nil;
+			img->destroy();
+			off += n;
+		}
+	}
+	Texture *tex = Texture::create(ras);
+	strncpy(tex->name, t.name, 32);
+	strncpy(tex->mask, t.mask, 32);
+	tex->filterAddressing = t.filterAddressing;
+	return tex;
+}
+
+// A hash of everything the renderer reads of a texture (FNV-1a 64: texture fields, raster
+// fields, every level byte), for tests/golden/textures*.txt. Those were recorded from librw's
+// readers before they were removed; REVC_TXD_GOLDEN=file reports every texture to Rust
+// (rust/revc/src/txdload.rs), which the formats test compares with the file.
+static uint64
+TxdHash(rw::Texture *tex)
+{
+	using namespace rw;
+	uint64 h = 0xcbf29ce484222325ull;
+	auto mix = [&h](const void *p, size_t n){
+		const uint8 *b = (const uint8*)p;
+		for(size_t i = 0; i < n; i++){ h ^= b[i]; h *= 0x100000001b3ull; }
+	};
+	auto mixi = [&mix](int32 v){ mix(&v, 4); };
+	Raster *r = tex->raster;
+	wgpu::WgpuRaster *n = GETWGPURASTEREXT(r);
+	mix(tex->mask, strnlen(tex->mask, 32));
+	mixi(tex->filterAddressing);
+	mixi(r->width); mixi(r->height); mixi(r->depth); mixi(r->format); mixi(r->type);
+	mixi(r->flags); mixi(r->stride); mixi(r->platform);
+	mixi(n->numLevels); mixi(n->hasAlpha); mixi(n->dxt); mixi(n->autogenMipmap);
+	mixi(n->baseWidth); mixi(n->baseHeight);
+	for(int32 i = 0; i < n->numLevels; i++){
+		int32 lw = n->baseWidth >> i, lh = n->baseHeight >> i;
+		if(lw < 1) lw = 1;
+		if(lh < 1) lh = 1;
+		size_t sz = n->dxt ? wgpu::dxtLevelSize(n->dxt, lw, lh) : (size_t)lw * lh * 4;
+		mixi(n->levels[i] != nil);
+		if(n->levels[i])
+			mix(n->levels[i], sz);
+	}
+	return h;
+}
