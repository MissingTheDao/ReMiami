+extern "C" void revc_txd_golden_line(const char *name, unsigned long long hash);
+
+static bool
+ReadNative(RwStream *stream, RwTexture **tex, RwUInt32 size)
+{
+	uint8 *body = new uint8[size];
+	if(RwStreamRead(stream, body, size) != size){
+		delete[] body;
+		return false;
+	}
+	RwTexture *rtex = nil;
+	RevcNativeTex nt;
+	if(revc_txd_read_native(body, size, &nt)){
+		rtex = TextureFromNative(nt);
+		revc_txd_free(&nt);
+	}
+	delete[] body;
+	static bool golden = getenv("REVC_TXD_GOLDEN") != nil;
+	if(rtex && golden)
+		revc_txd_golden_line(rtex->name, (unsigned long long)TxdHash(rtex));
+	*tex = rtex;
+	return rtex != nil;
+}
